--- !u!114 &874504640
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 874504638}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The goal of the game is to connect power from the starting transformers
    all the way to the ending transformers or goal. The goal may not always be a
    transformer.\n\nTo do this, you can click and drag power lines from one tower
    to another. To delete lines you have already placed, click on the lines themselves.\n\nYou
    can also place additional towers wherever you would like. Be careful though\u2014towers
    and lines can only be placed on cerain terrain.\n\nIf you misplace a tower, you
    can cut it down for free using the chainsaw. The chainsaw can also be used to
    cut down trees for an additional cost.\n\nFinally, in the top left there will
    be trivia questions. To make progress in the game, answer trivia questions to
    get resources to build towers, place lines, and cut down trees."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
